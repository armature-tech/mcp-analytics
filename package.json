{
  "name": "@armature-tech/mcp-analytics",
  "version": "0.0.0-development",
  "type": "module",
  "description": "MCP analytics wrapper SDK that instruments MCP tool declarations with telemetry.",
  "license": "Apache-2.0",
  "author": "Armature <support@armature.tech>",
  "homepage": "https://github.com/armature-tech/mcp-analytics#readme",
  "bugs": {
    "url": "https://github.com/armature-tech/mcp-analytics/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/armature-tech/mcp-analytics.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "analytics",
    "telemetry",
    "observability",
    "instrumentation",
    "armature",
    "mastra",
    "fastmcp",
    "mcp-handler"
  ],
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "bin": {
    "mcp-analytics": "./dist/esm/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./mastra": {
      "import": {
        "types": "./dist/esm/mastra.d.ts",
        "default": "./dist/esm/mastra.js"
      },
      "require": {
        "types": "./dist/cjs/mastra.d.ts",
        "default": "./dist/cjs/mastra.js"
      }
    },
    "./fastmcp": {
      "import": {
        "types": "./dist/esm/fastmcp.d.ts",
        "default": "./dist/esm/fastmcp.js"
      },
      "require": {
        "types": "./dist/cjs/fastmcp.d.ts",
        "default": "./dist/cjs/fastmcp.js"
      }
    },
    "./mcp-handler": {
      "import": {
        "types": "./dist/esm/mcp-handler.d.ts",
        "default": "./dist/esm/mcp-handler.js"
      },
      "require": {
        "types": "./dist/cjs/mcp-handler.d.ts",
        "default": "./dist/cjs/mcp-handler.js"
      }
    },
    "./v2": {
      "import": {
        "types": "./dist/esm/v2.d.ts",
        "default": "./dist/esm/v2.js"
      },
      "require": {
        "types": "./dist/cjs/v2.d.ts",
        "default": "./dist/cjs/v2.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "SKILL.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev:armature": "tsx experimental/mock-env/mock-armature-server.ts",
    "dev:instrumented-server": "tsx experimental/mock-env/instrumented-mock-example-mcp-server.ts",
    "dev:server": "tsx experimental/mock-env/mock-example-mcp-server.ts",
    "demo": "tsx experimental/mock-env/demo-client.ts",
    "demo:instrumented": "tsx experimental/mock-env/instrumented-demo-client.ts",
    "benchmark:redaction": "tsx scripts/benchmark-redaction.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:artifact-canary": "npm run build && node scripts/run-publish-canary.mjs",
    "test:platform-canary": "node scripts/run-publish-canary.mjs --require-platform",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "tsc --noEmit -p tsconfig.test.json",
    "check": "npm run typecheck:all && npm test",
    "clean": "rm -rf dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:markers": "node -e \"require('fs').writeFileSync('dist/esm/package.json', '{\\\"type\\\":\\\"module\\\"}\\n'); require('fs').writeFileSync('dist/cjs/package.json', '{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
    "build:version": "node scripts/stamp-version.mjs",
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:markers && npm run build:version",
    "prepublishOnly": "npm run check && npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20.0 <2",
    "@modelcontextprotocol/server": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/sdk": "1.26.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.10.2",
    "fastmcp": "4.12.1",
    "mcp-handler": "1.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
